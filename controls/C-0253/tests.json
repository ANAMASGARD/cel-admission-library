    ]
  },
  {
    "name": "Registry boundary",
    "template": "pod.yaml",
    "expected": "pass",
    "field_change_list": [
      "metadata.namespace=kube-system",
      "spec.containers.[0].image=k8s.gcr.io.example/pause:3.9"
    ]
  }
