[
    {
        "name": "pod Inherited non-root UID and GID",
        "template": "pod.yaml",
        "expected": "pass",
        "field_change_list": [
            "spec.securityContext={\"runAsUser\": 1000, \"runAsGroup\": 2000}"
        ]
    },
    {
        "name": "pod Missing group",
        "template": "pod.yaml",
        "expected": "fail",
        "field_change_list": [
            "spec.securityContext={\"runAsNonRoot\": true}"
        ]
    },
    {
        "name": "pod Container overrides inherited group",
        "template": "pod.yaml",
        "expected": "fail",
        "field_change_list": [
            "spec.securityContext={\"runAsUser\": 2, \"runAsGroup\": 2}",
            "spec.containers.[0].securityContext={\"runAsGroup\": 0}"
        ]
    },
    {
        "name": "pod Root user and group",
        "template": "pod.yaml",
        "expected": "fail",
        "field_change_list": [
            "spec.securityContext={\"runAsUser\": 0, \"runAsGroup\": 0}"
        ]
    },
    {
        "name": "pod Independent escalation control",
        "template": "pod.yaml",
        "expected": "pass",
        "field_change_list": [
            "spec.containers.[0].securityContext={\"runAsNonRoot\": true, \"runAsGroup\": 2000, \"allowPrivilegeEscalation\": true}"
        ]
    },
    {
        "name": "pod Init overrides UID",
        "template": "pod.yaml",
        "expected": "fail",
        "field_change_list": [
            "spec.securityContext={\"runAsUser\": 1000, \"runAsGroup\": 1000}",
            "spec.initContainers=[{\"name\": \"init\", \"image\": \"busybox\", \"securityContext\": {\"runAsUser\": 0}}]"
        ]
    },
    {
        "name": "pod Windows omits GID",
        "template": "pod.yaml",
        "expected": "pass",
        "field_change_list": [
            "spec.os.name=\"windows\"",
            "spec.securityContext={\"runAsNonRoot\": true}"
        ]
    },
